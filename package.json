{
  "name": "cmon-yo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "NODE_ENV=production node dist/server/main.js",
    "build": "vite build && vite build --ssr src/server/main.ts --outDir dist/server && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:web": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests *.ts",
    "test:ios": "bash scripts/test-ios-simulator.sh"
  },
  "dependencies": {
    "@fastify/middie": "9.3.4",
    "@fastify/static": "10.1.3",
    "@tanstack/react-query": "5.102.8",
    "@vanilla-extract/css": "1.21.2",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
