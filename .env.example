# 이 파일을 .env로 복사한 뒤 .env에만 실제 값을 입력합니다.
# .env는 Git에서 제외됩니다. 이 예시 파일에는 비밀값을 넣지 않습니다.
# 실행: npm run with-env -- dev
# 값에 공백이나 #이 있으면 따옴표로 감쌉니다. ${VAR} 치환은 하지 않습니다.

# ── 현재 서버에서 사용하는 값 ──
HOST=127.0.0.1
PORT=3000

# PostgreSQL 17+ 연결 문자열. 시설 조회·import에 필요합니다.
# 로컬 DB는 개발 환경에서 직접 구성할 수 있으며 외부 서비스 가입/키가 필요 없습니다.
# 운영 DB 주소·접근 권한은 배포할 때 별도로 준비합니다.
# 예: postgresql://cmon:CHANGE_ME@127.0.0.1:5432/cmon
# URL의 사용자명/암호에 예약 문자가 있으면 해당 부분을 percent-encode합니다.
# 관리형 DB는 공급자가 제공하는 연결 문자열과 TLS 설정을 사용합니다.
DATABASE_URL=

# 실제 DB 통합 검사에 사용할 별도 개발/테스트 DB입니다.
# 비어 있으면 DB 검사 3개가 skip됩니다. 운영 DB를 지정하지 않습니다.
TEST_DATABASE_URL=

# 기상청 API허브에서 발급한 authKey 원문입니다.
# https://apihub.kma.go.kr/apiList.do?seqApi=10
# 현재 adapter는 공공데이터포털의 serviceKey 대신 API허브 authKey를 사용합니다.
# 비어 있으면 시설은 표시하고 날씨는 조회 불가로 표시합니다.
# 키 없는 정상/실패 흐름 QA: npm run with-env -- qa:places (합성 응답, 공식 실연결 아님)
KMA_API_KEY=

# 현재 모임은 공개 fixture입니다. 실제 사용자/모임 데이터를 넣지 않습니다.
MEETUP_FIXTURE_PATH=contracts/fixtures/meetup.json

# NODE_ENV는 여기에 고정하지 않습니다. npm start가 production으로 설정합니다.
# 시설 원본 공개 파일 수집에는 별도의 API 키가 필요하지 않습니다.

# ── Native 실행 설정 ──
# SwiftUI 앱이 읽는 변수입니다. 서버의 .env를 앱이 자동으로 읽지는 않습니다.
# Xcode Scheme의 실행 환경변수 또는 simctl의 SIMCTL_CHILD_*로 전달합니다.
# Simulator의 로컬 API 주소이며 실기기에서는 접근 가능한 서버 주소가 필요합니다.
CMON_API_URL=http://127.0.0.1:3000
CMON_START_TAB=places
CMON_MEETUP_ID=11111111-1111-4111-8111-111111111111

# ── 인증 연결을 위한 준비 메모: 아래 SETUP_*는 현재 앱에서 읽지 않습니다 ──
# 이메일 직접 가입과 Google·카카오·네이버, iOS 배포용 Apple 로그인 준비 항목입니다.
# 인증 연결 구현은 후속 PR3A 작업이며 현재는 어느 공급자도 연결되지 않았습니다.
# 값을 적어도 로그인이 켜지지 않습니다.
# 공급자 콘솔 설정을 대신 적용하지 않으며, 확정된 런타임 변수명도 아닙니다.
# 일반 서비스 사용자가 입력할 값이 아니라 개발·운영자가 준비하는 설정입니다.

# 인증 후 Web/iOS 복귀 주소와 공급자 → 인증 서버 callback은 서로 다릅니다.
# 현재 callback route와 iOS 로그인 복귀 경로는 구현 전입니다.
# URL은 실제 구현·배포 주소를 정한 뒤 콘솔에 동일하게 등록합니다.
SETUP_WEB_ORIGIN=http://127.0.0.1:3000
SETUP_WEB_AUTH_RETURN_URL=
SETUP_IOS_AUTH_RETURN_URL=

# Google Auth Platform > Clients > Web application의 client ID와 secret입니다.
# https://console.cloud.google.com/auth/clients
# 앱/WebView에 client secret을 전달하지 않습니다.
# callback을 Authorized redirect URIs에 등록하고 동의 화면·테스트 사용자를 확인합니다.
# https://developers.google.com/identity/protocols/oauth2/web-server
SETUP_GOOGLE_WEB_CLIENT_ID=
SETUP_GOOGLE_WEB_CLIENT_SECRET=
SETUP_GOOGLE_CALLBACK_URL=

# iOS에서 Google Native SDK를 채택할 때만 필요한 별도 client ID입니다.
# Web OAuth 방식을 쓰는 경우에는 필수가 아닙니다. 현재 선택·구현 전이므로 비워 둡니다.
# iOS OAuth client의 bundle ID는 현재 앱의 app.heznpc.cmonyo와 일치해야 합니다.
# https://developers.google.com/identity/sign-in/ios/start-integrating
SETUP_GOOGLE_IOS_CLIENT_ID=

# 카카오 로그인 사용 설정·REST API 키·Client Secret·Redirect URI·동의 항목을 확인합니다.
# 로그인 REST 연결용이며 지도 API/카카오톡 메시지 권한과는 다릅니다.
# SDK 키는 실제 SDK 채택 시에만 별도 추가합니다.
# https://developers.kakao.com/docs/ko/kakaologin/prerequisite
SETUP_KAKAO_REST_API_KEY=
SETUP_KAKAO_CLIENT_SECRET=
SETUP_KAKAO_CALLBACK_URL=

# 네이버 애플리케이션의 Client ID/Secret, 서비스 URL·Callback URL을 확인합니다.
# 동의 항목·테스트 계정·실서비스 이용 조건은 해당 콘솔에서 별도로 확인합니다.
# https://developers.naver.com/docs/login/api/api.md
SETUP_NAVER_CLIENT_ID=
SETUP_NAVER_CLIENT_SECRET=
SETUP_NAVER_CALLBACK_URL=

# Apple: 멤버십 보유와 이 앱의 Sign in with Apple 설정 완료는 다릅니다.
# 앱 App ID의 capability, Web Services ID·도메인·Return URL 및 로그인용 서명 키를 확인합니다.
# App Store Connect API 키를 로그인용 키로 간주하지 않습니다.
# 개인 키 파일은 저장소 밖에 보관하고 경로만 비공개 .env/배포 secret에 지정합니다.
# https://developer.apple.com/help/account/capabilities/configure-sign-in-with-apple-for-the-web/
SETUP_APPLE_TEAM_ID=
SETUP_APPLE_APP_ID=
SETUP_APPLE_SERVICES_ID=
SETUP_APPLE_KEY_ID=
SETUP_APPLE_PRIVATE_KEY_PATH=
SETUP_APPLE_CALLBACK_URL=

# 이메일 직접 가입의 인증·비밀번호 재설정 메일 발송 준비 항목입니다.
# 로컬 개발은 로컬 수신함을 사용할 수 있고 외부 발송 성공과 구분합니다.
# 실제 발송 시 SMTP 또는 선택한 인증 서비스의 메일 설정 중 사용하는 값만 입력합니다.
# 발신 주소/도메인 인증과 수신 성공은 별도 확인합니다. 실제 사용자 암호를 넣지 않습니다.
SETUP_EMAIL_SMTP_HOST=
SETUP_EMAIL_SMTP_PORT=
SETUP_EMAIL_SMTP_USER=
SETUP_EMAIL_SMTP_PASSWORD=
SETUP_EMAIL_FROM=

# 아래 두 값은 현재 입력 불필요합니다. Supabase는 미연결 후보입니다.
# 로컬 DB/개발에 Supabase 가입·프로젝트·키가 필요하지 않습니다.
# Auth 채택 시에만 이메일·각 공급자의 지원 범위와 설정, callback을 확인합니다.
# https://supabase.com/docs/guides/getting-started/api-keys
# 관리자용 secret/service_role 키는 현재 준비 항목이 아닙니다.
SETUP_SUPABASE_URL=
SETUP_SUPABASE_PUBLISHABLE_KEY=

# 텍스트 게시글·모임/게시글 댓글은 자체 API/DB로 구현하며 채팅 SaaS 키가 필요하지 않습니다.
# GPS·HealthKit은 기기 권한/entitlement 설정이며 별도 외부 API 키가 아닙니다.
# 지도·Push·관측 서비스의 공급자별 값은 해당 기능을 채택할 때 추가합니다.
