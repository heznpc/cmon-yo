# 이 파일을 .env로 복사한 뒤 .env에만 실제 값을 입력합니다.
# .env는 Git에서 제외됩니다. 이 예시 파일에는 비밀값을 넣지 않습니다.
# 실행: npm run with-env -- dev
# 값에 공백이나 #이 있으면 따옴표로 감쌉니다. ${VAR} 치환은 하지 않습니다.

# ── 현재 서버에서 사용하는 값 ──
HOST=127.0.0.1
PORT=3000

# PostgreSQL 17+ 연결 문자열. 시설 조회·import와 계정 저장에 필요합니다.
# 로컬 DB는 개발 환경에서 직접 구성할 수 있으며 외부 서비스 가입/키가 필요 없습니다.
# 운영 DB 주소·접근 권한은 배포할 때 별도로 준비합니다.
# 예: postgresql://cmon:CHANGE_ME@127.0.0.1:5432/cmon
# URL의 사용자명/암호에 예약 문자가 있으면 해당 부분을 percent-encode합니다.
# 관리형 DB는 공급자가 제공하는 연결 문자열과 TLS 설정을 사용합니다.
DATABASE_URL=

# 실제 DB 통합 검사에 사용할 별도 개발/테스트 DB입니다.
# 비어 있으면 실제 DB 통합 검사는 skip됩니다. 운영 DB를 지정하지 않습니다.
TEST_DATABASE_URL=

# 기상청 API허브에서 발급한 authKey 원문입니다.
# https://apihub.kma.go.kr/apiList.do?seqApi=10
# 현재 adapter는 공공데이터포털의 serviceKey 대신 API허브 authKey를 사용합니다.
# 비어 있으면 시설은 표시하고 날씨는 조회 불가로 표시합니다.
# 키 없는 정상/실패 흐름 QA: npm run with-env -- qa:places (합성 응답, 공식 실연결 아님)
KMA_API_KEY=

# 현재 모임은 공개 fixture입니다. 실제 사용자/모임 데이터를 넣지 않습니다.
# 실제 모임이 기본입니다. fixture는 읽기 전용 회귀 시험에서만 선택합니다.
MEETUP_SOURCE=database
MEETUP_FIXTURE_PATH=contracts/fixtures/meetup.json

# NODE_ENV는 여기에 고정하지 않습니다. npm start가 production으로 설정합니다.
# 시설 원본 공개 파일 수집에는 별도의 API 키가 필요하지 않습니다.

# ── Native 실행 설정 ──
# SwiftUI 앱이 읽는 변수입니다. 서버의 .env를 앱이 자동으로 읽지는 않습니다.
# Xcode Scheme의 실행 환경변수 또는 simctl의 SIMCTL_CHILD_*로 전달합니다.
# Simulator의 로컬 API 주소이며 실기기에서는 접근 가능한 서버 주소가 필요합니다.
CMON_API_URL=http://127.0.0.1:3000
CMON_START_TAB=places
CMON_MEETUP_ID=11111111-1111-4111-8111-111111111111

# ── 현재 Web 인증 런타임 설정 ──
# Better Auth + 위 DATABASE_URL을 사용합니다. 외부 인증/DB 서비스 가입은 불필요합니다.
# 첫 실행 전에: npm run with-env -- auth -- migrate
# AUTH_SECRET이 비어 있으면 계정 서비스는 503이며 공개 조회는 계속 동작합니다.
# 충분히 긴 임의 비밀값(32자 이상)을 생성해 .env에만 보관합니다.
# 이 값을 바꾸면 기존 세션/암호화된 공급자 토큰을 계속 사용할 수 없습니다.
AUTH_SECRET=
# 운영은 HTTPS origin. path/trailing slash 없이 적고 공급자 console에도 같은 origin을 사용합니다.
AUTH_ORIGIN=http://127.0.0.1:3000

# local: 개발 전용 .cache/auth-mail의 비공개 파일 수신함. 외부 메일을 보내지 않습니다.
# smtp: 실제 발송. production에서는 smtp 설정이 필요합니다.
AUTH_MAIL_TRANSPORT=local
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
# SMTP 서버·발신 도메인 인증·실제 수신 성공은 별도 확인합니다.

# 공급자별 ID/secret을 둘 다 입력한 경우에만 해당 로그인 버튼을 표시합니다.
# 키가 없는 동안 이메일 기능·나머지 개발은 계속할 수 있습니다.
# 아래 네 공급자는 callback 처리 코드를 연결했으며 실제 공급자 왕복은 각각 미검증입니다.
# OAuth callback은 공급자 -> 서버 주소이며 Native 로그인 복귀 주소와 다릅니다.
# 콘솔에 <AUTH_ORIGIN>/api/auth/callback/<provider>를 정확히 등록합니다.
# 앱/WebView에는 client secret을 전달하지 않습니다.

# Google Web application ID/secret; callback: /api/auth/callback/google
# https://developers.google.com/identity/protocols/oauth2/web-server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 REST API 키와 Client Secret; callback: /api/auth/callback/kakao
# 로그인 사용 설정, 이메일 동의 항목, 테스트 계정을 확인합니다. 지도/메시지 키와 다릅니다.
# https://developers.kakao.com/docs/ko/kakaologin/prerequisite
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 Client ID/secret; callback: /api/auth/callback/naver
# 서비스 URL, 동의/테스트 및 실서비스 이용 조건도 확인합니다.
# https://developers.naver.com/docs/login/api/api.md
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Apple Web Services ID와 로그인용 서명 키로 생성한 client secret JWT입니다.
# callback: /api/auth/callback/apple (Apple이 허용하는 HTTPS 도메인 필요)
# App Store Connect API 키를 로그인용 키로 사용하지 않습니다. JWT 만료 전에 갱신합니다.
# https://developer.apple.com/help/account/capabilities/configure-sign-in-with-apple-for-the-web/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── 아래 SETUP_*는 Native 연결 준비 메모이며 현재 코드에서 읽지 않습니다 ──
# Native 복귀와 WKWebView 동일 identity 연결은 아직 구현/검증 전입니다.
SETUP_IOS_AUTH_RETURN_URL=
# iOS Native SDK 채택 시에만 별도 필요; Web OAuth에는 불필요합니다.
SETUP_GOOGLE_IOS_CLIENT_ID=
# Apple client secret 생성용 메모. 개인 키는 저장소 밖에 보관합니다.
SETUP_APPLE_TEAM_ID=
SETUP_APPLE_APP_ID=
SETUP_APPLE_KEY_ID=
SETUP_APPLE_PRIVATE_KEY_PATH=

# 텍스트 게시글·모임/게시글 댓글은 자체 API/DB로 구현하며 채팅 SaaS 키가 필요하지 않습니다.
# GPS·HealthKit은 기기 권한/entitlement 설정이며 별도 외부 API 키가 아닙니다.
# 지도·Push·관측 서비스의 공급자별 값은 해당 기능을 채택할 때 추가합니다.

# 같은 서버의 Caddy를 통해 서비스할 때만 loopback. 직접 실행은 비워 둡니다.
TRUST_PROXY=
